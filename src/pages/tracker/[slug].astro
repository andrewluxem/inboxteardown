---
// The current tracker's page. With a content file that has days it is the
// full tracker (TrackerLive). Before day 1 (no content file, or one with no
// days) it is the pre-start page (TrackerSoon) at the same URL, so a link to
// the tracker never 404s and never shows "Day 0".
import type { GetStaticPaths } from 'astro';
import TrackerLive from '../../components/TrackerLive.astro';
import TrackerSoon from '../../components/TrackerSoon.astro';
import { CURRENT_TRACKER, CURRENT_TRACKER_START, getTrackers } from '../../lib/content';
import { hasStarted } from '../../lib/tracker';
import type { Tracker } from '../../lib/schemas';

export const getStaticPaths = (async () => {
  const trackers = await getTrackers();
  const paths: { params: { slug: string }; props: { tracker?: Tracker } }[] =
    trackers.map((t) => ({ params: { slug: t.data.slug }, props: { tracker: t.data } }));
  if (!trackers.some((t) => t.data.slug === CURRENT_TRACKER)) {
    paths.push({ params: { slug: CURRENT_TRACKER }, props: {} });
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props { tracker?: Tracker }
const { tracker } = Astro.props;
---
{tracker && hasStarted(tracker) ? <TrackerLive tracker={tracker} /> : <TrackerSoon start={tracker?.start ?? CURRENT_TRACKER_START} tracker={tracker} />}
