---
// The tracker page until its data may be shown: no content file yet, one with
// `published: false`, or one with no days. Evergreen only: when tracking
// starts, what counts as started, the brands we track now, and how to get
// notified. Always public (indexable, in the sitemap and nav), no banner.
import Base from '../layouts/Base.astro';
import SignupForm from './SignupForm.astro';
import { CURRENT_TRACKER, getTrackedBrands } from '../lib/content';
import { formatShort } from '../lib/dates';
import { ogPath } from '../lib/og';
import { startedDefinition } from '../lib/tracker';
import type { Tracker } from '../lib/schemas';

interface Props {
  start: string;
  /** The content file, when one exists (its data is never shown here). */
  tracker?: Tracker;
}
const { start, tracker } = Astro.props;
const year = start.slice(0, 4);
const title = tracker?.title ?? `Black Friday ${year} tracker`;
const brands = await getTrackedBrands();
---
<Base title={title} description={`Which brands have started Black Friday ${year} email. Tracking starts ${formatShort(start)}.`} ogImage={ogPath.tracker(tracker?.slug ?? CURRENT_TRACKER)}>
  <p class="eyebrow num">{title}</p>
  <h1 class="display soon-h1">Starts <span class="accent">{formatShort(start)}</span></h1>
  <p class="lede soon-lede">From {formatShort(start)}, this page tracks which brands in our inbox have started Black Friday email, updated daily.</p>

  <section class="section" aria-labelledby="soon-started">
    <h2 id="soon-started" class="display soon-h2">What counts as started</h2>
    <p class="soon-def">{startedDefinition(start)}</p>
  </section>

  <section class="section" aria-labelledby="soon-brands">
    <h2 id="soon-brands" class="display soon-h2">Brands we track now</h2>
    <p class="soon-def">The {brands.length} brands on our daily scoreboard today.</p>
    <ul class="soon-brands card">
      {brands.map((b) => <li><a href={`/brand/${b.slug}/`}>{b.name}</a></li>)}
    </ul>
  </section>

  <section class="section card dark soon-cta" aria-labelledby="soon-notify">
    <p class="eyebrow">Get notified</p>
    <h2 id="soon-notify" class="display soon-h2">Email me the day the first brand starts</h2>
    <p class="soon-cta-sub">This page updates daily from {formatShort(start)}.</p>
    <SignupForm list="bfcm" button="Email me the day the first brand starts" />
  </section>
</Base>

<style>
  .soon-h1 { margin-top: 14px; max-width: 18ch; }
  .soon-lede { margin-top: 18px; }
  .soon-h2 { font-size: 1.75rem; }
  .soon-def { margin-top: 12px; max-width: var(--measure); color: var(--ink-2); }
  .soon-brands { list-style: none; margin-top: 16px; padding: 12px 20px; columns: 3 200px; column-gap: 24px; }
  .soon-brands li { break-inside: avoid; padding-block: 6px; }
  .soon-brands a { display: inline-block; padding-block: 4px; }
  .soon-cta { margin-top: 56px; padding: 32px; }
  .soon-cta h2 { margin-top: 8px; max-width: 22ch; }
  .soon-cta-sub { margin-top: 12px; max-width: var(--measure); color: var(--on-dark-muted); }
</style>
