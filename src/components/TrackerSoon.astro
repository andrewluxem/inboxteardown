---
// The tracker page before its content file exists: when tracking starts and
// what counts as started. noindex; not in the sitemap or navigation.
import Base from '../layouts/Base.astro';
import { formatShort } from '../lib/dates';
import { startedDefinition } from '../lib/tracker';

interface Props { start: string }
const { start } = Astro.props;
const year = start.slice(0, 4);
---
<Base title={`Black Friday ${year} tracker`} description={`The Black Friday ${year} tracker starts ${formatShort(start)}.`} noindex>
  <p class="eyebrow num">Black Friday {year} tracker</p>
  <h1 class="display soon-h1">Starts <span class="accent">{formatShort(start)}</span></h1>
  <p class="lede soon-lede">From {formatShort(start)}, this page tracks which brands in our inbox have started Black Friday email, updated daily.</p>
  <p class="soon-def">{startedDefinition(start)}</p>

  <section class="section cta-band dark" aria-labelledby="soon-cta">
    <div>
      <p class="eyebrow">Watchlist</p>
      <h2 id="soon-cta" class="display">The Watchlist is coming</h2>
    </div>
    <a class="btn btn--accent" href="/watchlist/">Join the Watchlist waitlist</a>
  </section>
</Base>

<style>
  .soon-h1 { margin-top: 14px; max-width: 18ch; }
  .soon-lede { margin-top: 18px; }
  .soon-def { margin-top: 12px; max-width: var(--measure); color: var(--ink-2); }
  .cta-band { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px 40px; padding: 32px; margin-top: 56px; }
  .cta-band h2 { margin-top: 8px; max-width: 22ch; }
</style>
